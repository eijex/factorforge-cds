{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactorForge Run Configuration Schema",
  "type": "object",
  "properties": {
    "target_host": {
      "type": "string",
      "default": "nbenthamiana"
    },
    "number_of_candidates": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "random_seed": {
      "type": "integer"
    },
    "optimizer_mode": {
      "type": "string"
    },
    "assembly_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["target_host"]
}
